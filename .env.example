# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=product_analytics_dev
BQ_LOCATION=US

# GA4 source date range (YYYYMMDD format)
# Controls which daily event tables dbt reads from the public dataset.
# Start with a narrow range (1-3 months) to control BigQuery costs.
GA4_START_DATE=20210101
GA4_END_DATE=20210131
